import random


class SnakeGame:
    def __init__(self, width=24, height=24):
        self.width = width
        self.height = height
        self.reset()

    def reset(self):
        self.snake = [
            (12, 12),
            (11, 12),
            (10, 12),
            (9, 12)
        ]

        self.direction = (1, 0)
        self.score = 0
        self.game_over = False

        self.food = self.generate_food()

    def generate_food(self):
        available_positions = [
            (x, y)
            for x in range(self.width)
            for y in range(self.height)
            if (x, y) not in self.snake
        ]

        return random.choice(available_positions)

    def change_direction(self, new_direction):
        opposite = (
            self.direction[0] + new_direction[0] == 0
            and
            self.direction[1] + new_direction[1] == 0
        )

        if not opposite:
            self.direction = new_direction

    def move(self):

        if self.game_over:
            return

        head_x, head_y = self.snake[0]

        dx, dy = self.direction

        new_head = (
            head_x + dx,
            head_y + dy
        )

        if self.check_collision(new_head):
            self.game_over = True
            return

        self.snake.insert(0, new_head)

        if new_head == self.food:
            self.score += 1
            self.food = self.generate_food()
        else:
            self.snake.pop()

    def check_collision(self, head):

        x, y = head

        if (
            x < 0
            or x >= self.width
            or y < 0
            or y >= self.height
        ):
            return True

        return head in self.snake


if __name__ == "__main__":

    game = SnakeGame()

    directions = {
        "w": (0, -1),
        "s": (0, 1),
        "a": (-1, 0),
        "d": (1, 0)
    }

    print("NEON SNAKE")
    print("Use W/A/S/D to control the snake.")
    print("Press Q to quit.")

    while not game.game_over:

        print(
            f"\nScore: {game.score}"
            f"\nSnake Head: {game.snake[0]}"
            f"\nFood: {game.food}"
        )

        key = input("Move: ").lower()

        if key == "q":
            break

        if key in directions:
            game.change_direction(directions[key])
            game.move()

    print("\nGAME OVER!")
    print(f"Final Score: {game.score}")
